{
  "name": "EOL",
  "version": "0.1.0",
  "private": true,
  "description": "EOL - END OF LINE",
  "main": "public/main.js",
  "homepage": "./",
  "dependencies": {
    "@azure/storage-blob": "^12.12.0",
    "@electron/remote": "^2.0.8",
    "@react-pdf-viewer/core": "^3.11.0",
    "@react-pdf-viewer/default-layout": "^3.11.0",
    "@react-pdf/renderer": "^3.1.4",
    "@reduxjs/toolkit": "^1.9.0",
    "@storybook/react": "^6.5.13",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.1.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.3",
    "dotenv-expand": "^9.0.0",
    "electron-is-dev": "^2.0.0",
    "eslint-plugin-sonarjs": "^0.16.0",
    "file-saver": "^2.0.5",
    "formik": "^2.2.9",
    "history": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "localforage": "^1.10.0",
    "localforage-memoryStorageDriver": "^0.9.2",
    "moment": "^2.30.1",
    "nanoid": "^4.0.0",
    "pdf-viewer": "^0.8.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-chartjs-2": "^5.1.0",
    "react-circular-progressbar": "^2.1.0",
    "react-csv": "^2.2.2",
    "react-date-range": "^1.4.0",
    "react-dom": "^18.2.0",
    "react-download-link": "^2.3.0",
    "react-js-pagination": "^3.0.3",
    "react-microsoft-login": "^1.15.0",
    "react-modal": "^3.16.1",
    "react-multi-select-component": "^4.3.4",
    "react-paginate": "^8.1.4",
    "react-pdf": "^6.2.2",
    "react-pdf-viewer": "^0.1.0",
    "react-redux": "^8.0.5",
    "react-router": "^5.3.4",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "5.0.1",
    "react-search-autocomplete": "^8.3.1",
    "react-select-search": "^4.1.8",
    "react-slick": "^0.29.0",
    "react-sortablejs": "^6.1.4",
    "react-tabs": "^5.1.0",
    "react-toastify": "^9.1.1",
    "react-webcam": "^7.1.1",
    "recharts": "^2.6.2",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.4.2",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^2.5.0",
    "sortablejs": "^1.15.6",
    "source-map-explorer": "^2.5.3",
    "uuid": "^9.0.0",
    "wait-on": "^6.0.1",
    "web-vitals": "^2.1.4",
    "yup": "^0.32.11"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --coverage --testResultsProcessor=jest-sonar-reporter --watchAll=false",
    "eject": "react-scripts eject",
    "electron:serve": "npx concurrently -k \"cross-env BROWSER=none npm run start\" \"npm run electron:start\"",
    "electron:build": "npm run build && electron-builder --windows -c.extraMetadata.main=build/main.js",
    "electron:start": "wait-on tcp:3000 && electron .",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "electron": "electron ."
  },
  "build": {
    "extends": null,
    "appId": "com.bluebinaries.bluebinaries",
    "artifactName": "EOL-setup-${version}.${ext}",
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraFiles": [
      ".env",
      ".env.production",
      "installer",
      "java-dependencies",
      "jdk-18_0_2_1_windows-x64_bin.exe",
      "BCMLog.xlsx",
      "DTC_Description_PVIU.xlsx"
    ],
    "extraResources": [
      "java-dependencies/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "uninstallDisplayName": "EOL -  END OF LINE",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": "true"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^7.1.0",
    "cross-env": "^7.0.3",
    "electron": "^18.2.0",
    "electron-builder": "^23.0.3",
    "electron-chromedriver": "^22.0.0",
    "enzyme": "^3.11.0",
    "eslint-plugin-sonarjs": "^0.15.0",
    "jest-sonar-reporter": "^2.0.0",
    "react-router-dom": "^6.3.0",
    "react-use-is-online": "^1.1.0",
    "sass": "^1.51.0"
  },
  "jestSonar": {
    "sonar56x": true,
    "reportPath": "testResults",
    "reportFile": "sonar-report.xml",
    "indent": 4
  }
}
